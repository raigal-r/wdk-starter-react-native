EXPO_PUBLIC_WDK_INDEXER_BASE_URL=https://wdk-api.tether.io
EXPO_PUBLIC_WDK_INDEXER_API_KEY=PUT_WDK_API_KEY_HERE
EXPO_PUBLIC_TRON_API_KEY=PUT_HERE
EXPO_PUBLIC_TRON_API_SECRET=PUT_HERE

# MoonPay fiat on-ramp (get keys at https://dashboard.moonpay.com)
# Use the pk_test_ key with 'sandbox' and the pk_live_ key with 'production'
EXPO_PUBLIC_MOONPAY_API_KEY=pk_test_PUT_HERE
EXPO_PUBLIC_MOONPAY_ENVIRONMENT=sandbox
# Optional: backend endpoint that signs widget URLs with your MoonPay secret
# key (required by MoonPay in production when pre-filling wallet addresses)
# EXPO_PUBLIC_MOONPAY_SIGN_URL=https://your-backend.example.com/moonpay/sign-url